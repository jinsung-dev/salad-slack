{
  "name": "@chatter/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/reset.ts",
    "vapid": "tsx devtools/vapid.ts"
  },
  "dependencies": {
    "@chatter/shared": "workspace:*",
    "@fastify/cookie": "11.1.3",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.1",
    "drizzle-kit": "0.31.11",
    "jose": "6.2.12",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "ws": "8.20.0"
  }
}
