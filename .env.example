DATABASE_URL=postgres://chatter:chatter@localhost:54329/chatter
PORT=3001
# Set to true when served over HTTPS.
COOKIE_SECURE=false
REDIS_URL=redis://localhost:56379
# 0.0.0.0 accepts other machines on the network (LAN testing, containers).
HOST=127.0.0.1
# Google Workspace domains allowed to sign in (comma-separated); empty allows any verified account.
ALLOWED_EMAIL_DOMAINS=saladlab.co
# Sign-in provider; leave unset for the local fake provider. See docs/google-sign-in.md.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=https://chatter.saladlab.co
# TRUST_PROXY=true
AUTH_RATE_LIMIT_PER_MINUTE=10
# Attachments (local disk; one server).
# FILE_STORAGE_DIR=./data/uploads
# FILE_MAX_BYTES=26214400
# Web push: generate with `pnpm --filter @chatter/server vapid`; changing keys drops existing subscriptions.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://chatter.example.com
